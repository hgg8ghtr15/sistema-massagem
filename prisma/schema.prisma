generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  nome         String
  senha        String
  perfis       String[]      @default(["CLIENTE"])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agendamentos Agendamento[]
  massagistas  MassagistaMassagem[]
}

model Agendamento {
  id          Int      @id @default(autoincrement())
  dataHora    DateTime
  status      String   @default("pendente")
  observacoes String?
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TokenRevogado {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model Massagem {
  id              Int                 @id @default(autoincrement())
  nome            String              @unique
  descricao       String
  duracaoMinutos  Int
  valorCentavos   Int
  youtubeUrl      String?
  ativo           Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  materiais       MassagemMaterial[]
  massagistas     MassagistaMassagem[]

  @@index([ativo])
}

model Material {
  id          Int                 @id @default(autoincrement())
  nome        String              @unique
  descricao   String?
  ativo       Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  massagens   MassagemMaterial[]

  @@index([ativo])
}

model MassagemMaterial {
  massagemId  Int
  materialId  Int
  quantidade  Int
  unidade     String
  massagem    Massagem @relation(fields: [massagemId], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([massagemId, materialId])
  @@index([materialId])
}

model MassagistaMassagem {
  usuarioId   Int
  massagemId  Int
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  massagem    Massagem @relation(fields: [massagemId], references: [id], onDelete: Cascade)

  @@id([usuarioId, massagemId])
  @@index([massagemId])
}